---
const baseUrl = import.meta.env.BASE_URL;
---

<script is:inline src="https://unpkg.com/popper.js@1"></script>
<script is:inline src="https://unpkg.com/tippy.js@4"></script>
<script is:inline>
  const BASE_URL = ${JSON.stringify(baseUrl)}
  const API_BASE = BASE_URL === '/' ? '' : BASE_URL.replace(/\/$/, '')

  function navToggle() {
    let btn = document.getElementById('menuBtn')
    let nav = document.getElementById('menu')

    btn.classList.toggle('open')
    nav.classList.toggle('flex')
    nav.classList.toggle('hidden')
  }

  window.addEventListener('scroll', function () {
    let btt = document.getElementById('btt')

    if (window.scrollY >= 1080) {
      btt.classList.remove('hidden')
      btt.classList.add('block')
    } else {
      btt.classList.add('hidden')
      btt.classList.remove('block')
    }
  })

  console.info('Code/Design: ttntm.me')

  const template = document.getElementById('followTip')
  const container = document.createElement('div')

  container.appendChild(document.importNode(template.content, true))

  tippy('#follow', {
    content: container.innerHTML,
    animation: 'scale',
    duration: 250,
    arrow: true,
    placement: 'bottom',
    interactive: true
  })

  const translations = {
    id: {
      'nav.lang': 'Bahasa',
      'nav.about': 'Tentang',
      'nav.features': 'Layanan',
      'nav.follow': 'Ikuti',
      'nav.contact': 'Hubungi',
      'btn.moreInfo': 'Informasi Lebih Lanjut',
      'btn.contactNow': 'Hubungi Sekarang',
      'btn.seeHow': 'Lihat Cara Kerjanya'
    },
    en: {
      'nav.lang': 'Language',
      'nav.about': 'About',
      'nav.features': 'Features',
      'nav.follow': 'Follow',
      'nav.contact': 'Contact Now',
      'btn.moreInfo': 'More Information',
      'btn.contactNow': 'Contact Now',
      'btn.seeHow': 'See How it Works'
    },
    tr: {
      'nav.lang': 'Dil',
      'nav.about': 'Hakkımızda',
      'nav.features': 'Hizmetler',
      'nav.follow': 'Takip Et',
      'nav.contact': 'İletişim',
      'btn.moreInfo': 'Daha Fazla Bilgi',
      'btn.contactNow': 'İletişim Kur',
      'btn.seeHow': 'Nasıl Çalıştığını Gör'
    }
  }

  function applyTranslations(lang) {
    const dict = translations[lang] || translations.en
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n')
      if (key && dict[key]) {
        el.textContent = dict[key]
      }
    })
  }

  function setLangActiveState(lang, buttons) {
    buttons.forEach((btn) => {
      const isActive = btn.getAttribute('data-lang') === lang
      btn.setAttribute('aria-pressed', String(isActive))
      btn.style.backgroundColor = isActive ? '#1f2937' : 'transparent'
      btn.style.color = isActive ? '#ffffff' : '#1f2937'
      btn.style.borderColor = '#1f2937'
    })
  }

  function setLanguage(lang) {
    localStorage.setItem('lang', lang)
    document.documentElement.lang = lang
    document.body.setAttribute('data-lang', lang)
    applyTranslations(lang)
  }

  async function loadFeaturesContent(lang) {
    try {
      const response = await fetch(`${API_BASE}/api/features/${lang}`)
      
      if (response.ok) {
        const features = await response.json()
        console.log(`Loaded ${features.length} features for language: ${lang}`)
        
        // Update setiap feature item
        features.forEach((feat, index) => {
          const featureDiv = document.querySelector(`[data-feature-index="${index}"]`)
          if (featureDiv) {
            const titleEl = featureDiv.querySelector('[data-feature-title]')
            const contentEl = featureDiv.querySelector('[data-feature-content]')
            
            if (titleEl) titleEl.textContent = feat.title
            if (contentEl) contentEl.textContent = feat.content
          }
        })
      }
    } catch (error) {
      console.error('Error loading features content:', error)
    }
  }

  async function loadMarkdownContent(lang) {
    try {
      const sections = document.querySelectorAll('[data-section-type]')
      console.log(`Loading markdown content for language: ${lang}`)
      
      for (const section of sections) {
        const sectionType = section.getAttribute('data-section-type')
        
        // Skip features section karena akan di-handle oleh loadFeaturesContent
        if (sectionType === 'features') {
          continue
        }
        
        const contentDiv = section.querySelector('[data-content]')
        
        if (!contentDiv) {
          console.warn(`No content div found for section: ${sectionType}`)
          continue
        }
        
        // Untuk bahasa EN, gunakan file default (tanpa suffix)
        // Untuk bahasa lain (ID, TR), gunakan file dengan suffix
        const filename = lang === 'en' ? `${sectionType}.md` : `${sectionType}.${lang}.md`
        const fileUrl = `${API_BASE}/api/sections/${filename}`
        console.log(`Fetching: ${fileUrl}`)
        const response = await fetch(fileUrl)
        
        if (response.ok) {
          const markdown = await response.text()
          // Parse frontmatter - content setelah --- kedua
          const parts = markdown.split('---')
          const content = parts[2] ? parts[2].trim() : ''
          
          console.log(`Loaded content for ${sectionType}: ${content.substring(0, 50)}...`)
          
          // Khusus untuk header, format content sebagai dua heading
          if (sectionType === 'header') {
            const lines = content.split('\n').filter(line => line.trim())
            if (lines.length >= 2) {
              const firstLine = lines[0]
              const secondLine = lines.slice(1).join(' ')
              contentDiv.innerHTML = `
                <h1 class="tracking-wide text-2xl mb-6" style="color: #f9ae19;">
                  ${firstLine}
                </h1>
                <h1 class="font-bold tracking-widest text-4xl">
                  ${secondLine}
                </h1>
              `
            }
          } else {
            // Untuk section lainnya gunakan marked
            if (window.marked) {
              const htmlContent = marked.parse(content)
              contentDiv.innerHTML = htmlContent
            } else {
              contentDiv.textContent = content
            }
          }
        } else {
          console.error(`Failed to fetch ${fileUrl}: ${response.status}`)
        }
      }
    } catch (error) {
      console.error('Error loading markdown content:', error)
    }
  }

  // Initialize language buttons
  const langButtons = Array.from(document.querySelectorAll('[data-lang]'))
  if (langButtons.length) {
    const stored = localStorage.getItem('lang')
    const browser = (navigator.language || 'en').slice(0, 2)
    const initial = stored || (['id', 'en', 'tr'].includes(browser) ? browser : 'en')

    setLanguage(initial)
    setLangActiveState(initial, langButtons)
    
    // Load content pada inisialisasi dengan delay untuk memastikan marked sudah loaded
    setTimeout(() => {
      loadMarkdownContent(initial)
      loadFeaturesContent(initial)
    }, 500)

    langButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang') || 'en'
        setLanguage(lang)
        setLangActiveState(lang, langButtons)
        loadMarkdownContent(lang)
        loadFeaturesContent(lang)
      })
    })
  }
</script>

<script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
