---
import siteData from '../data/site.json'

const pn = Astro.url.pathname
const isHome = pn === '/'
const site = Astro.site
const abtLink = isHome
  ? '#about'
  : `${site}#about`
const ftLink = isHome
  ? '#features'
  : `${site}#features`
const currentYear = new Date().getFullYear()
---
<footer class="w-full flex flex-col sm:flex-row sm:justify-center text-lg tracking-wide px-4 sm:px-0 py-16" style="background-color: #1f2937;">
  <div class="text-center pr-0 sm:pr-8 py-4">
    <ul class="list-none">
      {siteData.social.map((scm) => (
        <li>
          <a class="text-gray-200 no-underline" href={scm.url} target="_blank" rel="_noopener" style="transition: color 0.3s;" onmouseover="this.style.color='#f9ae19'" onmouseout="this.style.color='#e5e7eb'">{scm.title}</a>
        </li>
      ))}
    </ul>
  </div>
  <div class="h-px sm:h-auto w-1/2 sm:w-px mx-auto sm:mx-0" style="background-color: #f9ae19;"></div>
  <div class="text-center px-8 py-4">
    <ul class="list-none">
      <li>
        <a class="text-gray-200 no-underline" href={abtLink} data-i18n="nav.about" style="transition: color 0.3s;" onmouseover="this.style.color='#f9ae19'" onmouseout="this.style.color='#e5e7eb'">About</a>
      </li>
      <li>
        <a class="text-gray-200 no-underline" href={ftLink} data-i18n="nav.features" style="transition: color 0.3s;" onmouseover="this.style.color='#f9ae19'" onmouseout="this.style.color='#e5e7eb'">Features</a>
      </li>
    </ul>
  </div>
  
</footer>
<div class="w-full" style="background-color: #1f2937;">
  <span class="block text-center text-gray-200 text-sm font-light pb-4">
    &copy; {currentYear} {siteData.author}
  </span>
</div>
<div class="">
  <a id="btt" class="hidden fixed bottom-0 right-0 mb-4 mr-4 text-gray-200 border hover:bg-gray-200 hover:border-browngray no-underline px-6 py-1 shadow-md" href="#top" title="Back to Top" style="border-color: #f9ae19; background-color: #f9ae19;" onmouseover="this.style.backgroundColor='transparent'; this.style.color='#f9ae19'" onmouseout="this.style.backgroundColor='#f9ae19'; this.style.color='#1f2937'">UP</a>
</div>
<!-- "Follow" Tooltip template -->
<template id="followTip">
  {siteData.social.map((scm) => (
    <a href={scm.url} class="inline-block text-gray-800 text-sm shadow-md hover:bg-gray-200 no-underline p-1 px-4 mx-2 my-1" style="background-color: #f9ae19;" target="_blank" rel="noopener">{scm.title}</a>
  ))}
</template>
