---
interface Props {
  title: string
  lang?: string
}

const { title, lang } = Astro.props
---
<div id="contact" class="w-full min-h-screen flex flex-col justify-center items-center py-12" data-section-type="contact">
  <div class="self-center text-center w-full xl:w-1/3 px-4 sm:px-0">
    <h2 class="font-bold tracking-widest text-gray-800 text-3xl mb-4">{title}</h2>
    <div class="font-light text-black text-lg" data-content>
        <slot />
    </div>
  </div>
</div>
