---
import type { CollectionEntry } from 'astro:content'
import About from './About.astro'
import Features from './Features.astro'
import Contact from './Contact.astro'

interface Props {
  afterTitle: string,
  sect: CollectionEntry<'sections'>,
  title: string,
  type: string,
  lang?: string
}

const { afterTitle, sect, title, type, lang } = Astro.props
const { Content } = await sect.render()
---

{type === 'about' && <About title={title} lang={lang}>
  <Content />
</About>}

{type === 'features' && <Features afterTitle={afterTitle} title={title} lang={lang}>
  <Content />
</Features>}

{type === 'contact' && <Contact title={title} lang={lang}>
  <Content />
</Contact>}
