---
interface Props {
  title: string
  lang?: string
}

const site = Astro.site
const { title, lang } = Astro.props
---
<div id="operations" class="w-full min-h-screen flex flex-col justify-center items-center py-12" style="background-color: white;" data-section-type="operations">
  <div class="self-center text-center w-full sm:w-2/3 xl:w-1/2 px-4 sm:px-0">
    <h2 class="font-bold tracking-wider text-gray-800 text-4xl mb-4">{title}</h2>
    <div class="font-light text-gray-700 text-xl" data-content>
      <slot />
    </div>
  </div>
  <div class="flex flex-row w-full justify-center mt-8">
    <a class="px-10 py-2 text-white rounded-full shadow-md text-lg hover:opacity-80 transition-opacity" href="#contact" data-i18n="nav.contact" style="background-color: #f9ae19;">Contact Now</a>
  </div>
</div>
