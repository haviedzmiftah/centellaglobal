---
import featuresData from '../../data/features.json'

interface Props {
  afterTitle?: string,
  title: string,
  lang?: string
}

const site = Astro.site
const baseUrl = import.meta.env.BASE_URL
const { afterTitle, title, lang } = Astro.props

// Gunakan bahasa default 'en' jika lang tidak tersedia
const currentLang = lang || 'en'
const features = featuresData[currentLang as keyof typeof featuresData] || featuresData.en
---
<div id="features" class="w-full min-h-screen flex flex-col justify-center items-center py-12" data-section-type="features">
  <div class="self-center text-center w-full sm:w-2/3 xl:w-1/2 px-4 sm:px-0">
    <h2 class="tracking-wide text-gray-800 font-bold text-4xl mb-4" data-section-title>{title}</h2>
    <div class="font-light text-black text-xl mb-6" data-content>
      <slot />
    </div>
  </div>
  <div class="self-center w-full xl:w-4/5 flex flex-col sm:flex-row flex-wrap px-4 xl:px:0" id="features-list">
    {features.map((feat, index) => (
      <div class="w-full sm:w-1/2 flex flex-row flex-no-wrap hover:shadow-lg hover:bg-gray-200 hover:bg-opacity-60 px-4 sm:px-8 py-6 sm:py-12" data-feature-index={index}>
        <div class="w-1/3 xl:w-1/4">
          <img src={`${baseUrl}img/features/${feat.icon}`} alt={feat.title} class="w-16 block sm:mx-auto" />
        </div>
        <div class="w-2/3 xl:w-3/4">
          <h3 class="tracking-wide font-bold text-2xl uppercase mb-2" style="color: #f9ae19;" data-feature-title>{feat.title}</h3>
          <div class="font-light text-gray-700 text-lg" data-feature-content>
            {feat.content}
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="self-center text-center w-full sm:w-1/3 px-4 sm:px-0">
    {afterTitle && <h3 class="font-bold tracking-widest text-gray-800 text-2xl my-6">{afterTitle}</h3>}
  </div>
    <div class="flex flex-row w-full justify-center pt-6">
    <a class="px-10 py-2 text-gray-800 rounded-full shadow-md text-lg hover:opacity-80 transition-opacity" href="#contact" data-i18n="btn.contactNow" style="background-color: #f9ae19;">Contact Now</a>
  </div>
</div>
